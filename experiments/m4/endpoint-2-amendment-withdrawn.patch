+/**
+ * Per-run statistic of the 2026-10-02 amended endpoint 2 ("late-excess-activity"):
+ * the rate of new evolutionary activity in the second half of the registered
+ * window, per 1e5 steps. `snaps` are the run's activity snapshots (the same
+ * ones `cumulativeNewActivity` is read from) at the activity threshold in use;
+ * `horizon` is the run's registered number of steps (manifest `spec.steps`).
+ *
+ *   final = the last snapshot
+ *   mid   = the last snapshot whose step <= floor(horizon / 2)
+ *   rate  = (final.cumulativeNew - mid.cumulativeNew) / (final.step - mid.step) * 1e5
+ *
+ * NaN when there is no snapshot, none at or before the half, or the final
+ * snapshot is not after the mid one. The "not calibrated" NaN (as for
+ * `cumulativeNewActivity`) is applied by the caller, since calibration is a
+ * property of the ensemble, not of the snapshots.
+ */
+export function lateNewActivityRate(snaps: { step: number; cumulativeNew: number }[], horizon: number): number {
+  const final = snaps[snaps.length - 1];
+  if (!final) return NaN;
+  const half = Math.floor(horizon / 2);
+  let mid: { step: number; cumulativeNew: number } | undefined;
+  for (const s of snaps) if (s.step <= half) mid = s;
+  if (!mid || !(final.step > mid.step)) return NaN;
+  return ((final.cumulativeNew - mid.cumulativeNew) / (final.step - mid.step)) * 1e5;
+}
