+// ---------------------------------------------------------------------------
+// Regression pin: the original results are byte-identical under the amended code.
+//
+// `sha256` values below were produced by the analysis code BEFORE the 2026-10-02
+// amendment was added (same recipe as `buildRuns`/tools/nullcal.ts, window 2e5,
+// 20 seeds per condition, census every 100, deep every 10, master seed 1,
+// ignoreFrozenThreshold). They hash, per ensemble: `results` (the four original
+// endpoint results), `heldOut`, `json` (report.json's pre-amendment content),
+// `markdown` (report.md's pre-amendment text) and the charts. The amendment
+// only ADDS: the `amended` key of `json`/result, and one contiguous block of
+// markdown between the primary endpoints and the held-out observables, both
+// removed here before hashing. Any change to an original endpoint, a
+// statistic, a table row or a number changes a hash and fails this test.
+// `summary` is the same information in readable form (orientation only).
+// ---------------------------------------------------------------------------
+
+const sha = (x: unknown) => createHash("sha256").update(typeof x === "string" ? x : JSON.stringify(x)).digest("hex");
+const r6 = (x: number) => (Number.isFinite(x) ? Number(x.toPrecision(6)) : null);
+
+function summarise(res: Awaited<ReturnType<typeof analyzeEnsemble>>): string[] {
+  const lines: string[] = [];
+  for (const r of res.results) {
+    if (r.kind === "test") {
+      for (const x of r.rows) lines.push(`${r.id} ${x.a}>${x.b} n=${x.nA}/${x.nB} effect=${r6(x.effect)} p=${r6(x.p)} pAdj=${r6(x.pAdj)} supported=${x.supported}`);
+    } else if (r.kind === "threshold") {
+      lines.push(`${r.id} available=${r.available} supported=${r.supported} ${r.rows.map((x) => `${x.condition}:${x.qualifying}/${x.total}`).join(" ")}`);
+    } else {
+      lines.push(`${r.id} ${r.qualifying}/${r.total} supported=${r.supported}`);
+    }
+  }
+  lines.push(`held-out ${res.heldOut.summary.outcome} established=${res.heldOut.summary.establishedCount}`);
+  lines.push(`threshold ${r6(res.json.threshold)}`);
+  return lines;
+}
+
+// report.json carries raw per-run means of series values, and the synthetic
+// generators use Math.exp/log/cos, whose last bits differ between V8 builds
+// (Deno 2.9.7 vs Node 26 differ in the 16th digit of the generated series
+// themselves). So `json` is hashed at 9 significant digits to stay portable;
+// `results` and `heldOut` are rank-based and hashed exactly.
+const roundedJson = (x: unknown) => JSON.stringify(x, (_k, v) => (typeof v === "number" && Number.isFinite(v) ? Number(v.toPrecision(9)) : v));
+
+function digests(res: Awaited<ReturnType<typeof analyzeEnsemble>>) {
+  const { amended: _jsonAmended, ...jsonBefore } = res.json;
+  const markdownBefore = res.markdown.replace(/\n## Amended endpoint 2 \(2026-10-02\)[\s\S]*?(?=\n## Held-out observables)/, "");
+  return {
+    results: sha(res.results),
+    heldOut: sha(res.heldOut),
+    json: sha(roundedJson(jsonBefore)),
+    markdown: sha(markdownBefore),
+    charts: sha(res.charts.map((c) => `${c.file}\n${c.svg}`).join("\n")),
+  };
+}
