+// ---- 2026-10-02 amendment: late-window excess activity (endpoint 2) ----
+//
+// Appended AFTER the freeze (experiments/FROZEN, 2026-09-27) and entirely
+// outside PRIMARY_ENDPOINTS / HELD_OUT_SPECS / ACTIVITY_THRESHOLDS:
+// nothing below is rendered into experiments/preregistration.md's GENERATED
+// sections (tools/gen-prereg.ts and experiments/test/prereg-sync.test.ts only
+// read PRIMARY_ENDPOINTS, HELD_OUT_SPECS and HELD_OUT_SUMMARY), so those
+// sections stay byte-identical. Draft and rationale:
+// experiments/preregistration.md, "Amendment, 2026-10-02" (drafted in
+// experiments/m4/endpoint-2-amendment-draft.md).
+//
+// Why: the original endpoint 2 ("unbounded-growth") needs at most a minority
+// of neutral runs classified "growing", which a frozen 95th-percentile
+// threshold makes essentially unsatisfiable (all 30 neutral runs of the
+// 2026-09-28 ensemble were "growing"). The amendment measures treatment's
+// late growth against neutral's instead of in absolute terms. The original
+// endpoint is still computed and reported, labelled superseded for the M4 gate.
+
+/** Key into a run's per-run statistics (RunView.stats) for the amended endpoint; see tools/analyze.ts's `lateNewActivityRate`. */
+export const LATE_RATE_STATISTIC = "lateNewActivityRate";
+
+/**
+ * Amended endpoint 2, as a TestEndpoint so the existing `evaluateEndpoint`
+ * machinery executes it unchanged: one comparison, so Holm is trivial and the
+ * adjusted p equals the one-sided exact Mann–Whitney p.
+ */
+export const LATE_EXCESS_ACTIVITY_ENDPOINT: TestEndpoint = {
+  id: "late-excess-activity",
+  kind: "test",
+  statistic: LATE_RATE_STATISTIC,
+  comparisons: [{ a: "treatment", b: "neutral", relation: "pGreater" }],
+  alpha: ALPHA,
+  description:
+    "**Amended endpoint 2 — late-window excess activity (2026-10-02).** Per-run statistic: the rate of new " +
+    "evolutionary activity in the second half of the registered window, i.e. cumulative new activity at the final " +
+    "census minus its value at the last census at or before half the registered horizon, per 10⁵ steps, with the " +
+    "frozen per-preset activity threshold of endpoint 1 unchanged. " +
+    `Hypothesis: treatment > neutral (one-sided exact Mann–Whitney, α = ${ALPHA}). Treatment must still be producing ` +
+    "adaptively significant lineages faster than the neutral shadow in the second half of the window; a treatment " +
+    "whose new activity falls back to neutral's rate, or saturates below it, fails. Within a finite window it " +
+    "cannot tell a real treatment effect that saturates more slowly than the window from open-ended growth (null " +
+    "calibration: the bounded-treatment scenario passes 32/32); it measures excess over neutral, not unboundedness. " +
+    "It replaces endpoint 2 (\"unbounded-growth\") in the M4 gate and is registered only for the fresh ensemble.",
+};
+
+export interface Amendment20261002 {
+  date: "2026-10-02";
+  /** The amended endpoint, executed by `evaluateEndpoint` like any other TestEndpoint. */
+  endpoint: TestEndpoint;
+  /** Fresh-ensemble seed range [first, last], inclusive. Disjoint from the M4 ensemble (1–20), the calibration pilot (1001–1020) and the registered extension (101–105, 1101–1110). */
+  seeds: [number, number];
+  /** Endpoint of PRIMARY_ENDPOINTS that is still computed and reported, but labelled superseded for the M4 gate. */
+  supersededEndpointId: string;
+  /** Label attached to the superseded endpoint wherever it is reported. */
+  supersededLabel: string;
+  /** M4 is met on a preset when every listed endpoint holds there, and met overall when that is so on every listed preset. */
+  gate: { endpointIds: string[]; presets: string[] };
+}
+
+export const AMENDMENT_2026_10_02: Amendment20261002 = {
+  date: "2026-10-02",
+  endpoint: LATE_EXCESS_ACTIVITY_ENDPOINT,
+  seeds: [21, 40],
+  supersededEndpointId: "unbounded-growth",
+  supersededLabel: "original; superseded for the M4 gate by the 2026-10-02 amendment",
+  gate: { endpointIds: ["adaptive-activity", LATE_EXCESS_ACTIVITY_ENDPOINT.id], presets: ["gradient-m3", "spots-m3"] },
+};
+
+/** Why the amended endpoint was not evaluated for an ensemble outside its registered seed range. */
+export function amendedNotEvaluatedReason(a: Amendment20261002 = AMENDMENT_2026_10_02): string {
+  return `not evaluated: the ${a.date} amendment registers it only for the fresh ensemble, seeds ${a.seeds[0]}–${a.seeds[1]}`;
+}
+
+export type AmendedGuard = { evaluate: true } | { evaluate: false; reason: string };
+
+/**
+ * Whether the amended endpoint may be evaluated for an ensemble. Allowed only
+ * for a synthetic ensemble (tools/nullcal.ts's null-generator calibration,
+ * `ignoreFrozenThreshold`) or when EVERY run's seed lies in the amendment's
+ * registered range. This enforces the amendment's rule that the 2026-09-28
+ * ensemble (seeds 1–20) is never re-read under the new endpoint: outside the
+ * range nothing is computed, not even descriptively.
+ */
+export function amendedEndpointGuard(seeds: number[], synthetic: boolean, a: Amendment20261002 = AMENDMENT_2026_10_02): AmendedGuard {
+  if (synthetic) return { evaluate: true };
+  const [first, last] = a.seeds;
+  if (seeds.length > 0 && seeds.every((s) => s >= first && s <= last)) return { evaluate: true };
+  return { evaluate: false, reason: amendedNotEvaluatedReason(a) };
+}
+
+/** The amended endpoint's result for one ensemble, or why it was not evaluated. */
+export type AmendedOutcome = { evaluated: true; result: TestResult } | { evaluated: false; reason: string };
+
+export type GateVerdict = "holds" | "fails" | "unavailable";
+
+export interface AmendedGate {
+  presetId: string;
+  /** Whether `presetId` is one of the presets the gate is registered for. */
+  registeredPreset: boolean;
+  endpoints: { id: string; verdict: GateVerdict; detail: string }[];
+  /** true: every gate endpoint holds on this preset; false: at least one fails; null: none fails but at least one is unavailable (or the preset is not a gate preset). */
+  met: boolean | null;
+}
+
+function testVerdict(r: EndpointResult | undefined): GateVerdict {
+  if (!r || r.kind !== "test" || !r.complete) return "unavailable";
+  return r.rows.every((row) => row.supported) ? "holds" : "fails";
+}
+
+/**
+ * The amended M4 gate for ONE preset's ensemble: endpoint 1 (from the
+ * ensemble's PRIMARY_ENDPOINTS results) and the amended endpoint 2 must both
+ * hold. Overall M4 needs the same on each preset in `gate.presets`; this
+ * summarises the preset at hand only. Pure.
+ */
+export function amendedM4Gate(presetId: string, primary: EndpointResult[], amended: AmendedOutcome, a: Amendment20261002 = AMENDMENT_2026_10_02): AmendedGate {
+  const endpoints = a.gate.endpointIds.map((id) => {
+    if (id === a.endpoint.id) {
+      return amended.evaluated
+        ? { id, verdict: testVerdict(amended.result), detail: "" }
+        : { id, verdict: "unavailable" as GateVerdict, detail: amended.reason };
+    }
+    const r = primary.find((x) => x.id === id);
+    return { id, verdict: testVerdict(r), detail: "" };
+  });
+  const registeredPreset = a.gate.presets.includes(presetId);
+  const met = !registeredPreset
+    ? null
+    : endpoints.some((e) => e.verdict === "fails")
+    ? false
+    : endpoints.every((e) => e.verdict === "holds")
+    ? true
+    : null;
+  return { presetId, registeredPreset, endpoints, met };
+}
