+// Tests for the 2026-10-02 amendment of endpoint 2 (late-window excess
+// activity; experiments/m4/endpoint-2-amendment-draft.md):
+//   - `lateNewActivityRate`, the per-run statistic (tools/analyze.ts);
+//   - the seed-range guard that keeps the 2026-09-28 ensemble from being
+//     re-read under the amended endpoint;
+//   - the shape of the amended endpoint / gate constants (experiments/endpoints.ts);
+//   - a regression pin: the ORIGINAL endpoints, held-out section, report.json
+//     fields, report.md text and charts are byte-identical to what the
+//     pre-amendment analysis code produced on synthetic nullcal ensembles.
+import { createHash } from "node:crypto";
+import { describe, expect, it } from "vitest";
+import { mannWhitney } from "@bl/metrics";
+import {
+  ACTIVITY_THRESHOLDS,
+  ALPHA,
+  AMENDMENT_2026_10_02,
+  amendedEndpointGuard,
+  amendedM4Gate,
+  amendedNotEvaluatedReason,
+  evaluateEndpoint,
+  LATE_EXCESS_ACTIVITY_ENDPOINT,
+  PRIMARY_ENDPOINTS,
+  type EndpointResult,
+  type RunView,
+  type TestResult,
+} from "../endpoints.ts";
+import { analyzeEnsemble, lateNewActivityRate, type Run } from "../../tools/analyze.ts";
+import { activities } from "../../tools/lib/bundle.ts";
+import {
+  boundedTreatmentVsFlat,
+  buildManifest,
+  makeSpec,
+  neutralDrift,
+  NULLCAL_CONDITIONS,
+  runNullGenerator,
+  type Identity,
+} from "../../tools/lib/nullgen.ts";
+
+const snap = (step: number, cumulativeNew: number) => ({ step, cumulativeNew });
+/** Snapshots every 100 steps up to 1000, with a hand-picked cumulative series. */
+const SERIES = [
+  snap(100, 0), snap(200, 1), snap(300, 1), snap(400, 2), snap(500, 4),
+  snap(600, 5), snap(700, 7), snap(800, 7), snap(900, 9), snap(1000, 12),
+];
+
+describe("lateNewActivityRate (per-run statistic of the amended endpoint 2)", () => {
+  it("is (final - mid) / (final.step - mid.step) * 1e5, mid = the last snapshot at or before half the horizon", () => {
+    // horizon 1000 -> half 500 -> mid = step 500 (cumulativeNew 4); final = step 1000 (12).
+    expect(lateNewActivityRate(SERIES, 1000)).toBe(((12 - 4) / (1000 - 500)) * 1e5);
+    expect(lateNewActivityRate(SERIES, 1000)).toBeCloseTo(1600, 9);
+  });
+
+  it("ignores everything before mid: only the two end points matter", () => {
+    const changedEarly = SERIES.map((s) => (s.step < 500 ? snap(s.step, s.cumulativeNew + 100) : s));
+    expect(lateNewActivityRate(changedEarly, 1000)).toBe(lateNewActivityRate(SERIES, 1000));
+    // ...and the interior of the late window does not matter either.
+    const changedInterior = SERIES.map((s) => (s.step > 500 && s.step < 1000 ? snap(s.step, 6) : s));
+    expect(lateNewActivityRate(changedInterior, 1000)).toBe(lateNewActivityRate(SERIES, 1000));
+  });
+
+  it("a snapshot exactly at floor(horizon/2) counts as 'at or before'", () => {
+    // Snapshot at step 500 is mid for horizon 1000 (above); drop it and mid falls back to step 400.
+    const without500 = SERIES.filter((s) => s.step !== 500);
+    expect(lateNewActivityRate(without500, 1000)).toBe(((12 - 2) / (1000 - 400)) * 1e5);
+  });
+
+  it("a snapshot one step past the half does not count as mid", () => {
+    const shifted = [snap(400, 2), snap(501, 4), snap(1000, 12)]; // 501 > floor(1000/2)
+    expect(lateNewActivityRate(shifted, 1000)).toBe(((12 - 2) / (1000 - 400)) * 1e5);
+  });
+
+  it("floors the half for an odd horizon", () => {
+    // horizon 1001 -> half 500 (floor of 500.5): step 500 is mid, step 501 is not.
+    const s = [snap(400, 2), snap(500, 4), snap(501, 5), snap(1001, 12)];
+    expect(lateNewActivityRate(s, 1001)).toBe(((12 - 4) / (1001 - 500)) * 1e5);
+    // horizon 999 -> half 499: step 500 is past the half, mid = step 400.
+    expect(lateNewActivityRate([snap(400, 2), snap(500, 4), snap(999, 12)], 999)).toBe(((12 - 2) / (999 - 400)) * 1e5);
+  });
+
+  it("uses the registered horizon, not the last snapshot's step", () => {
+    // A run that stopped at step 800 is judged against horizon 1000: half 500 is still mid.
+    const stopped = SERIES.filter((s) => s.step <= 800);
+    expect(lateNewActivityRate(stopped, 1000)).toBe(((7 - 4) / (800 - 500)) * 1e5);
+  });
+
+  it("is 0 when no new activity arrives in the second half, and never negative on a monotone series", () => {
+    expect(lateNewActivityRate([snap(500, 3), snap(1000, 3)], 1000)).toBe(0);
+    expect(lateNewActivityRate(SERIES, 1000)).toBeGreaterThan(0);
+  });
+
+  it("is NaN with no snapshots", () => {
+    expect(lateNewActivityRate([], 1000)).toBeNaN();
+  });
+
+  it("is NaN with no snapshot at or before the half", () => {
+    expect(lateNewActivityRate([snap(600, 5), snap(700, 7), snap(1000, 12)], 1000)).toBeNaN();
+  });
+
+  it("is NaN when the final snapshot is the mid snapshot", () => {
+    expect(lateNewActivityRate([snap(400, 2)], 1000)).toBeNaN();
+    // The run ended at or before the half of the registered horizon: final.step === mid.step.
+    expect(lateNewActivityRate([snap(100, 0), snap(500, 4)], 1000)).toBeNaN();
+  });
+
+  it("is NaN for a non-finite horizon", () => {
+    expect(lateNewActivityRate(SERIES, NaN)).toBeNaN();
+  });
+});
+
+// ---- helpers: in-memory synthetic ensembles, exactly as tools/nullcal.ts builds them ----
+
+type Gen = (id: Identity, spec: ReturnType<typeof makeSpec>) => ReturnType<typeof neutralDrift>;
+
+function buildRuns(opts: {
+  gen: Gen;
+  nullId?: string;
+  windowSteps: number;
+  seedsPerCondition: number;
+  replicate?: number;
+  /** Maps seedIndex -> the run's numeric seed (default: seedIndex, as nullcal does). */
+  seedOf?: (seedIndex: number) => number;
+  /** Replaces the spec's preset id (default: the nullcal preset "gradient-m3"). */
+  presetId?: string;
+  conditions?: readonly string[];
+}): Run[] {
+  const { gen, windowSteps, seedsPerCondition } = opts;
+  const nullId = opts.nullId ?? "test";
+  const rep = opts.replicate ?? 0;
+  const runs: Run[] = [];
+  for (const condition of opts.conditions ?? NULLCAL_CONDITIONS) {
+    for (let seedIndex = 0; seedIndex < seedsPerCondition; seedIndex++) {
+      const id: Identity = { masterSeed: 1, nullId, windowSteps, replicateIndex: rep, condition, seedIndex };
+      const base = makeSpec("nullcal", condition, opts.seedOf ? opts.seedOf(seedIndex) : seedIndex, windowSteps, 100, 10);
+      const spec = opts.presetId ? { ...base, presetId: opts.presetId } : base;
+      const bundle = gen(id, spec);
+      const manifest = buildManifest(spec, nullId, windowSteps, rep, bundle.generatorParams);
+      const lineages = new Map<number, [string, number][]>();
+      for (const row of bundle.lineages) {
+        let arr = lineages.get(row.step);
+        if (!arr) lineages.set(row.step, (arr = []));
+        arr.push([row.key, row.cells]);
+      }
+      runs.push({ condition, seed: spec.seed, dir: `${nullId}/${condition}/seed-${spec.seed}`, series: bundle.series, lineages, manifest });
+    }
+  }
+  return runs;
+}
+
+const NEUTRAL_DRIFT: Gen = (id, s) => neutralDrift(id, s);
+
+describe("the seed-range guard (the 2026-09-28 ensemble is never re-read under the amended endpoint)", () => {
+  const range = (a: number, b: number) => Array.from({ length: b - a + 1 }, (_, i) => a + i);
+
+  it("amendedEndpointGuard: only an all-seeds-in-21..40 ensemble, or a synthetic one, is evaluated", () => {
+    expect(amendedEndpointGuard(range(21, 40), false)).toEqual({ evaluate: true });
+    expect(amendedEndpointGuard([21], false)).toEqual({ evaluate: true });
+    expect(amendedEndpointGuard([40], false)).toEqual({ evaluate: true });
+    const refused = (seeds: number[]) => amendedEndpointGuard(seeds, false);
+    // The 2026-09-28 ensemble (seeds 1-20), the calibration pilot, the extension, one-off neighbours and a partial overlap.
+    for (const seeds of [range(1, 20), range(1001, 1020), range(101, 105), range(1101, 1110), [20, 21], [40, 41], [0], [...range(21, 39), 41], [...range(1, 5), ...range(21, 25)], []]) {
+      expect(refused(seeds)).toEqual({ evaluate: false, reason: "not evaluated: the 2026-10-02 amendment registers it only for the fresh ensemble, seeds 21–40" });
+    }
+    // Synthetic ensembles (nullcal) are exempt whatever their seeds.
+    expect(amendedEndpointGuard(range(0, 19), true)).toEqual({ evaluate: true });
+    expect(amendedEndpointGuard([], true)).toEqual({ evaluate: true });
+  });
+
+  it("analyzeEnsemble: real-style seeds outside 21-40 -> not evaluated, nothing computed", async () => {
+    // "seasons" is not in ACTIVITY_THRESHOLDS, so this exercises the non-synthetic path (no ignoreFrozenThreshold) without founder provenance.
+    const runs = buildRuns({ gen: NEUTRAL_DRIFT, windowSteps: 20_000, seedsPerCondition: 6, presetId: "seasons", seedOf: (i) => 1 + i });
+    const res = await analyzeEnsemble(runs, "guard-outside", {});
+    expect(res.json.thresholdMode).toBe("exploratory");
+    const reason = "not evaluated: the 2026-10-02 amendment registers it only for the fresh ensemble, seeds 21–40";
+    expect(res.amended.endpoint).toEqual({ evaluated: false, reason });
+    expect(res.amended.runs).toBeNull();
+    expect(res.amended.m4Gate.met).toBeNull();
+    expect(res.amended.m4Gate.endpoints.find((e) => e.id === "late-excess-activity")).toMatchObject({ verdict: "unavailable", detail: reason });
+    expect(res.json.amended).toBe(res.amended);
+    expect(res.markdown).toContain("## Amended endpoint 2 (2026-10-02)");
+    expect(res.markdown).toContain(`${reason}.`);
