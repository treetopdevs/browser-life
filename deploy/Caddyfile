:80 {
  encode zstd gzip

  # Keep the shared garden private, including named gardens and keeper APIs.
  @private_garden path_regexp private_garden (?i)^/(garden(?:/|$)|api/(?:public/)?gardens?(?:/|$))
  respond @private_garden 404

  # Creative particle prototype is local-only until separately approved for release.
  @private_particles path_regexp private_particles (?i)^/particles(?:/|$)
  respond @private_particles 404

  # Standalone field prototype remains local-only.
  @private_boundaries path_regexp private_boundaries (?i)^/boundaries(?:/|$)
  respond @private_boundaries 404

  # Developmental bodies are another local creative prototype.
  @private_development path_regexp private_development (?i)^/development(?:/|$)
  respond @private_development 404

  # Counted matter aquarium remains a local creative prototype.
  @private_matter path_regexp private_matter (?i)^/matter(?:/|$)
  respond @private_matter 404

  # Selective nutrient-current toy and sampled replay stay local.
  @private_currents path_regexp private_currents (?i)^/currents(?:/|$)
  respond @private_currents 404

  # Volumetric particle playground stays local.
  @private_spatial path_regexp private_spatial (?i)^/spatial(?:/|$)
  respond @private_spatial 404

  # Reunited creative ecosystem and local prototype directory.
  @private_ecosystem path_regexp private_ecosystem (?i)^/ecosystem(?:/|$)
  respond @private_ecosystem 404
  @private_playground path_regexp private_playground (?i)^/playground(?:/|$)
  respond @private_playground 404

  # Local vision calibration gallery.
  @private_vision_screen path_regexp private_vision_screen (?i)^/vision-screen(?:/|$)
  respond @private_vision_screen 404

  @api path /api/*
  reverse_proxy @api coordinator:4000 {
    header_up X-Forwarded-Proto https
  }

  handle /healthz {
    rewrite * /api/public/status
    reverse_proxy coordinator:4000 {
      header_up X-Forwarded-Proto https
    }
  }

  root * /srv

  # One address per page, the one its canonical link names: /worlds answers 308 to /worlds/, keeping the query.
  # Targets are written out rather than built from the request path, so a crafted path cannot redirect off-site.
  redir /lab /lab/{?query} 308
  redir /worlds /worlds/{?query} 308
  redir /how-it-works /how-it-works/{?query} 308
  redir /research /research/{?query} 308
  redir /about /about/{?query} 308
  redir /participate /participate/{?query} 308
  redir /status /status/{?query} 308
  redir /privacy /privacy/{?query} 308

  # A link that names a world (/lab/?world=<id> plants it, /worlds/?world=<id> shows its card) previews as that
  # world: the build writes a copy of each page per world, differing only in its title, description and card, at
  # /<page>/world/<id>/. Unknown worlds get the plain page. The copies are for links, not addresses: one opened
  # directly is sent to the link it stands for.
  @world_copy path_regexp world_copy ^/(lab|worlds)/world/([a-z0-9-]{1,64})/(?:index\.html)?$
  redir @world_copy /{re.world_copy.1}/?world={re.world_copy.2} 308
  @world_lab {
    path /lab/
    expression {query.world}.matches("^[a-z0-9-]{1,64}$")
    file /lab/world/{query.world}/index.html
  }
  rewrite @world_lab /lab/world/{query.world}/index.html
  @world_worlds {
    path /worlds/
    expression {query.world}.matches("^[a-z0-9-]{1,64}$")
    file /worlds/world/{query.world}/index.html
  }
  rewrite @world_worlds /worlds/world/{query.world}/index.html

  # Vite fingerprints everything under /assets/, so it never changes; the fonts change only with a release.
  header /assets/* Cache-Control "public, max-age=31536000, immutable"
  header /fonts/* Cache-Control "public, max-age=2592000"
  header /site.webmanifest Content-Type application/manifest+json

  # The not-found page is only ever an answer to a miss: asked for by name it answers 404 too.
  error /404.html 404
  try_files {path} {path}/index.html
  file_server

  # An unknown site path answers 404 with the site's own page. The paths Phoenix answers, /api/* and /healthz, keep
  # its answers (a bare /api is not one of them: it is a site path and gets the page), and other errors (a 502 while
  # the coordinator is down) keep Caddy's empty one. A miss is never stored: `no-store` replaces any Cache-Control set
  # above (the immutable year on /assets/*), and 404.html's own ETag and Last-Modified are dropped, so no cache keeps
  # the miss heuristically or revalidates it against 404.html. The conditional and range headers are dropped from the
  # request, so an `If-None-Match` or a `Range` cannot turn the page into an empty 404 or a slice of it. The status is
  # matched by expression, the long-standing form, rather than the newer `handle_errors 404`; production runs
  # caddy:2.10 (Dockerfile.site).
  handle_errors {
    @page {
      expression {err.status_code} == 404
      not path /api/* /healthz
    }
    handle @page {
      request_header -If-None-Match
      request_header -If-Modified-Since
      request_header -If-Match
      request_header -If-Unmodified-Since
      request_header -If-Range
      request_header -Range
      header {
        Cache-Control "no-store"
        -ETag
        -Last-Modified
      }
      rewrite * /404.html
      file_server
    }
  }
}
