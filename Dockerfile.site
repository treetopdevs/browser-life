FROM node:22-alpine AS build

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.14.0 --activate
COPY . .
RUN pnpm install --frozen-lockfile && pnpm build && rm -rf apps/lab/dist/garden apps/lab/dist/particles apps/lab/dist/assets/particles-*.js apps/lab/dist/assets/particles-*.css apps/lab/dist/assets/particlePicker-*.js apps/lab/dist/assets/particlePicker-*.css apps/lab/dist/assets/particleOases-*.js apps/lab/dist/assets/particleOases-*.css apps/lab/dist/assets/particleSeasons-*.js apps/lab/dist/assets/particleSeasons-*.css apps/lab/dist/assets/particleBonds-*.js apps/lab/dist/assets/particleBonds-*.css apps/lab/dist/assets/particleMotifs-*.js apps/lab/dist/assets/particleMotifs-*.css apps/lab/dist/boundaries apps/lab/dist/assets/boundaries-*.js apps/lab/dist/assets/boundaries-*.css apps/lab/dist/hungry-shapes apps/lab/dist/assets/hungryShapes*.js apps/lab/dist/assets/hungryShapes*.css apps/lab/dist/assets/hungryShapes*.json apps/lab/dist/assets/hungry-shapes*.js apps/lab/dist/assets/hungry-shapes*.css apps/lab/dist/assets/hungry-shapes*.json apps/lab/dist/assets/hungry-shapes*.mp4 apps/lab/dist/assets/hungry-shapes*.webm apps/lab/dist/development apps/lab/dist/assets/development-*.js apps/lab/dist/assets/development-*.css apps/lab/dist/matter apps/lab/dist/assets/matter-*.js apps/lab/dist/assets/matter-*.css apps/lab/dist/ecosystem apps/lab/dist/playground apps/lab/dist/assets/ecosystem-*.js apps/lab/dist/assets/ecosystem-*.css apps/lab/dist/assets/ecosystem-*.mp4 apps/lab/dist/assets/ecosystem-*.json apps/lab/dist/assets/ecosystemArchive*.js apps/lab/dist/assets/ecosystemArchive*.css apps/lab/dist/assets/ecosystemArchive*.json apps/lab/dist/assets/playground-*.js apps/lab/dist/assets/playground-*.css apps/lab/dist/spatial apps/lab/dist/assets/spatial-*.js apps/lab/dist/assets/spatial-*.css apps/lab/dist/currents apps/lab/dist/assets/currents-*.js apps/lab/dist/assets/currents-*.css apps/lab/dist/assets/currents-*.gz apps/lab/dist/assets/currents-*.replay apps/lab/dist/assets/current-pilot-*.json apps/lab/dist/vision-screen apps/lab/dist/assets/vision-screen-*.js apps/lab/dist/assets/vision-screen-*.css apps/lab/dist/assets/visionScreen-*.js apps/lab/dist/assets/visionScreen-*.css

FROM caddy:2.10-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/apps/lab/dist /srv
EXPOSE 80
